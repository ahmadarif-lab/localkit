{
  // Static site only: no Worker script, files are served straight from dist/.
  "name": "localkit",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "localkit.ahmadarif.id", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
