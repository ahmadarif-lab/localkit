/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' blob: data: https://localkit-api.ahmadarif.id; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # cross-origin isolation lets the AI model use several threads
  Cross-Origin-Embedder-Policy: require-corp
  # stops Cloudflare from injecting its analytics beacon into the HTML
  Cache-Control: no-transform, public, max-age=0, must-revalidate

/assets/*
  ! Cache-Control
  Cache-Control: no-transform, public, max-age=31536000, immutable

/pdfjs/*
  ! Cache-Control
  Cache-Control: no-transform, public, max-age=2592000
